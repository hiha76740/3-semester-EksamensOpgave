<nav class="vidensvejen-navigation" aria-label="Administration">
    <RadzenStack Gap="0.3rem">
        <NavLink class="vidensvejen-nav-link" href="" Match="NavLinkMatch.All">
            <RadzenIcon Icon="home" aria-hidden="true" />
            Forside
        </NavLink>
        <NavLink class="vidensvejen-nav-link" href="exhibition/create" Match="NavLinkMatch.All">
            <RadzenIcon Icon="layers" aria-hidden="true" />
            Udstillinger
        </NavLink>
        <NavLink class="vidensvejen-nav-link" href="games/create" Match="NavLinkMatch.All">
            <RadzenIcon Icon="quiz" aria-hidden="true" />
            Quizzer
        </NavLink>
        <NavLink class="vidensvejen-nav-link" href="images" Match="NavLinkMatch.All">
            <RadzenIcon Icon="perm_media" aria-hidden="true" />
            Mediebibliotek
        </NavLink>
        <AuthorizeView>
            <Authorized Context="auth">
                @if (auth.User.HasClaim(CustomClaimTypes.Permission, "User.Read")
                    || auth.User.HasClaim(CustomClaimTypes.Permission, "User.Create"))
                {
                    <NavLink class="vidensvejen-nav-link" href="users" Match="NavLinkMatch.All">
                        <RadzenIcon Icon="group" aria-hidden="true" />
                        Brugere
                    </NavLink>
                }
            </Authorized>
        </AuthorizeView>
        <span class="vidensvejen-nav-link vidensvejen-nav-disabled" aria-disabled="true">
            <RadzenIcon Icon="settings" aria-hidden="true" />
            Indstillinger
        </span>
    </RadzenStack>
</nav>

<RadzenTemplateForm TItem="QuizInputModel" Data="@Model" Submit="@HandleSubmit">
    <RadzenStack Gap="1rem" Class="rz-my-4 rz-mx-auto rz-px-4" Style="max-width: 1000px;">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.H2" Text="@FormTitle" />
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Status: Kladde" />
        </RadzenStack>

        @if (Message != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false">@Message</RadzenAlert>
        }

        @if (Errors.Count > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Text="Kontrollér følgende" />
                    @foreach (var error in Errors)
                    {
                        <RadzenText Text="@error" />
                    }
                </RadzenStack>
            </RadzenAlert>
        }

        <QuizDetailsComponent Model="Model" Exhibitions="Exhibitions" LockedExhibitionName="@LockedExhibitionName" Changed="Changed" />

        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
                             AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <RadzenText TextStyle="TextStyle.H4" Text="Spørgsmål" />
                    <RadzenButton ButtonType="ButtonType.Button" Text="Tilføj spørgsmål" Icon="add" Click="AddQuestion" />
                </RadzenStack>

                @for (var index = 0; index < Model.Questions.Count; index++)
                {
                    var question = Model.Questions[index];
                    <QuizQuestionComponent @key="question.Id" Question="question" Number="@(index + 1)"
                                        CanRemove="@(Model.Questions.Count > 1)" Changed="Changed"
                                        Remove="@(() => RemoveQuestion(question))" />
                }

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"
                             Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="@ResetText" Variant="Variant.Outlined" ButtonType="ButtonType.Button" Click="@(() => ResetCallback.InvokeAsync())" />
                    <RadzenButton Text="@SubmitText" ButtonType="ButtonType.Submit" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <QuizDraftPreviewComponent Title="@Model.Title" Instruction="@Model.Instruction" Question="Model.Questions[0]" />
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter, EditorRequired]
    public QuizInputModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public string FormTitle { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public EventCallback<QuizInputModel> SubmitCallback { get; set; }

    [Parameter, EditorRequired]
    public EventCallback ResetCallback { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public IReadOnlyList<string> Errors { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ExhibitionNameResponse> Exhibitions { get; set; } = [];

    [Parameter]
    public string ResetText { get; set; } = "Nulstil";

    [Parameter]
    public string? LockedExhibitionName { get; set; }

    private Task HandleSubmit(QuizInputModel submittedModel) => SubmitCallback.InvokeAsync(submittedModel);

    private async Task AddQuestion()
    {
        Model.Questions.Add(new QuizQuestionInputModel());
        await Changed.InvokeAsync();
    }

    private async Task RemoveQuestion(QuizQuestionInputModel question)
    {
        if (Model.Questions.Count > 1)
        {
            Model.Questions.Remove(question);
        }

        await Changed.InvokeAsync();
    }
}

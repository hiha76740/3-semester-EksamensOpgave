@inject DialogService Dialog
@inject IQuizService QuizService

@if (quiz != null)
{
    <QuizFormComponent Model="quiz" FormTitle="Quizkladde" CanSubmit="false"
                       LockedExhibitionName="@ExhibitionName" Exhibitions="noExhibitions"
                       SaveDraftCallback="SaveAsync" ResetCallback="Cancel" ResetText="Annullér"
                       IsBusy="isSaving" Errors="errors" />
}
else if (errors.Count > 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@errors[0]</RadzenAlert>
}
else
{
    <RadzenText Text="Henter quizkladde …" />
}

@code {
    [Parameter, EditorRequired]
    public string ExhibitionName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public Guid ExhibitionId { get; set; }

    [Parameter]
    public Guid? QuizDraftId { get; set; }

    private QuizInputModel? quiz;
    private Guid? draftId;
    private bool isSaving;
    private readonly IReadOnlyList<ExhibitionNameResponse> noExhibitions = [];
    private readonly List<string> errors = [];

    protected override async Task OnInitializedAsync()
    {
        draftId = QuizDraftId;
        try
        {
            if (draftId is Guid id)
            {
                var draft = await QuizService.GetDraftAsync(id);
                quiz = QuizEditorMapper.FromDraft(draft);
                quiz.RowVersion = draft.RowVersion;
            }
            else
            {
                quiz = new QuizInputModel();
            }

            quiz.ExhibitionId = ExhibitionId;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == HttpStatusCode.NotFound)
        {
            Dialog.Close(false);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            errors.Add("Quizkladden kunne ikke hentes.");
        }
    }

    private async Task SaveAsync(QuizInputModel input)
    {
        if (isSaving)
        {
            return;
        }

        isSaving = true;
        errors.Clear();
        try
        {
            var id = draftId ??= await QuizService.CreateDraftAsync();
            if (input.RowVersion.Length == 0)
            {
                input.RowVersion = (await QuizService.GetDraftAsync(id)).RowVersion;
            }

            await QuizService.SaveDraftAsync(id, QuizEditorMapper.BuildDraftRequest(input));
            Dialog.Close(id);
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            errors.Add("Quizkladden kunne ikke gemmes. Kontrollér, om kladden stadig findes, eller åbn den igen.");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel() => Dialog.Close();
}

@using VidensVejen.ContractsLib.Responses.ExhibitionService
@using VidensVejen.Web.Models
@using VidensVejen.Web.Models.Games

<RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H4" Text="Quizinformation" />
        <RadzenFormField Text="Titel *">
            <RadzenTextBox @bind-Value="Model.Title" @bind-Value:after="NotifyChanged" Placeholder="Fx Affald og genbrug" />
        </RadzenFormField>
        <RadzenFormField Text="Instruktion *">
            <RadzenTextArea @bind-Value="Model.Instruction" @bind-Value:after="NotifyChanged" Rows="3"
                            Placeholder="Skriv en kort instruktion til gæsten." />
        </RadzenFormField>
        <RadzenFormField Text="Udstilling *">
            <RadzenDropDown TValue="Guid?" Data="@Exhibitions"
                            TextProperty="@nameof(ExhibitionNameResponse.Name)"
                            ValueProperty="@nameof(ExhibitionNameResponse.Id)"
                            @bind-Value="Model.ExhibitionId" @bind-Value:after="NotifyChanged"
                            Placeholder="Vælg en udstilling" AllowFiltering="true"
                            Disabled="@(Exhibitions.Count == 0)" />
        </RadzenFormField>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter, EditorRequired]
    public QuizInputModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ExhibitionNameResponse> Exhibitions { get; set; } = [];

    private Task NotifyChanged() => Changed.InvokeAsync();
}

<RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H4" Text="Quizinformation" />
        <RadzenFormField Text="Titel * (DA)">
            <RadzenTextBox @bind-Value="Model.Title" @bind-Value:after="NotifyChanged" Placeholder="Fx Affald og genbrug" />
        </RadzenFormField>
        <RadzenFormField Text="Titel * (EN)">
            <RadzenTextBox @bind-Value="Model.TitleEn" @bind-Value:after="NotifyChanged" Placeholder="Fx Affald og genbrug" />
        </RadzenFormField>
        <RadzenFormField Text="Instruktion * (DA)">
            <RadzenTextArea @bind-Value="Model.Instruction" @bind-Value:after="NotifyChanged" Rows="3"
                            Placeholder="Skriv en kort instruktion til gæsten." />
        </RadzenFormField>
        <RadzenFormField Text="Instruktion * (EN)">
            <RadzenTextArea @bind-Value="Model.InstructionEn" @bind-Value:after="NotifyChanged" Rows="3"
                            Placeholder="Skriv en kort instruktion til gæsten." />
        </RadzenFormField>
        <RadzenFormField Text="Quizlayout *">
            <RadzenDropDown TValue="string" Data="@Layouts" @bind-Value="Model.QuizLayout"
                            @bind-Value:after="NotifyChanged" Placeholder="Vælg quizlayout" />
        </RadzenFormField>
        <RadzenFormField Text="Afsluttende besked (DA)">
            <RadzenTextArea @bind-Value="Model.EndMessage" @bind-Value:after="NotifyChanged" Rows="2" />
        </RadzenFormField>
        <RadzenFormField Text="Afsluttende besked (EN)">
            <RadzenTextArea @bind-Value="Model.EndMessageEn" @bind-Value:after="NotifyChanged" Rows="2" />
        </RadzenFormField>
        @if (LockedExhibitionName != null)
        {
            <RadzenFormField Text="Udstilling">
                <RadzenTextBox Value="@LockedExhibitionName" ReadOnly="true" />
            </RadzenFormField>
        }
        else
        {
            <RadzenFormField Text="Udstilling *">
                <RadzenDropDown TValue="Guid?" Data="@Exhibitions"
                                TextProperty="@nameof(ExhibitionNameResponse.Name)"
                                ValueProperty="@nameof(ExhibitionNameResponse.Id)"
                                @bind-Value="Model.ExhibitionId" @bind-Value:after="NotifyChanged"
                                Placeholder="Vælg en udstilling" AllowFiltering="true"
                                Disabled="@(Exhibitions.Count == 0)" />
            </RadzenFormField>
        }
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter, EditorRequired]
    public QuizInputModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<ExhibitionNameResponse> Exhibitions { get; set; } = [];

    [Parameter]
    public string? LockedExhibitionName { get; set; }

    private static readonly string[] Layouts = ["Vertikalt", "Horisontalt"];

    private Task NotifyChanged() => Changed.InvokeAsync();
}

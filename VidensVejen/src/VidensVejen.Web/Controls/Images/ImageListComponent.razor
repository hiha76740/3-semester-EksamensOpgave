<RadzenDataGrid TItem="ImageResponse" Data="@Images"
                AllowPaging="true" PageSize="15" AllowSorting="true"
                EmptyText="Der er endnu ingen billeder i mediebiblioteket.">
    <Columns>
        <RadzenDataGridColumn TItem="ImageResponse" Title="Forhåndsvisning" Sortable="false">
            <Template Context="image">
                <RadzenImage Path="@image.Url" AlternateText="@($"Billede {image.Id}")"
                             Style="width: 6rem; height: 4rem; object-fit: contain;" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="ImageResponse" Title="Filendelse"
                              Property="@nameof(ImageResponse.Extension)" />
        <RadzenDataGridColumn TItem="ImageResponse" Title="Billed-ID"
                              Property="@nameof(ImageResponse.Id)" />
        <AuthorizeView Policy="Image.Delete">
            <RadzenDataGridColumn TItem="ImageResponse" Title="Handling" Sortable="false">
                <Template Context="image">
                    <RadzenButton Text="Slet" Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Outlined" Disabled="@(IsDeleting || image.RowVersion == null || image.RowVersion.Length == 0)"
                                  Click="@(() => DeleteRequested.InvokeAsync(image))" />
                </Template>
            </RadzenDataGridColumn>
        </AuthorizeView>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ImageResponse> Images { get; set; } = [];

    [Parameter]
    public EventCallback<ImageResponse> DeleteRequested { get; set; }

    [Parameter]
    public bool IsDeleting { get; set; }
}

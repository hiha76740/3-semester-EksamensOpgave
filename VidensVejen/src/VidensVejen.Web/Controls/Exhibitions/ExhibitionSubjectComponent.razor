@inject DialogService Dialog
@inject IQuizService QuizService

<RadzenStack Gap="0.75rem">
    <RadzenFormField Text="Titel * (DA)">
        <RadzenTextBox @bind-Value="Model.Title" />
    </RadzenFormField>
    <RadzenFormField Text="Titel * (EN)">
        <RadzenTextBox @bind-Value="Model.TitleEn" />
    </RadzenFormField>
    <RadzenFormField Text="Beskrivelse * (DA)">
        <RadzenTextArea @bind-Value="Model.Description" Rows="3" />
    </RadzenFormField>
    <RadzenFormField Text="Beskrivelse * (EN)">
        <RadzenTextArea @bind-Value="Model.DescriptionEn" Rows="3" />
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenCheckBox TValue="bool" Name="@($"{Id}-quiz")" @bind-Value="Model.IsQuiz"
                        @bind-Value:after="LoadQuizOptionsAsync" />
        <RadzenLabel Text="Dette subject er en quiz" Component="@($"{Id}-quiz")" />
    </RadzenStack>
    @if (Model.IsQuiz)
    {
        @if (quizOptionsError)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">Quizzerne kunne ikke hentes.</RadzenAlert>
            <RadzenButton Text="Prøv igen" Click="LoadQuizOptionsAsync" />
        }
        <RadzenFormField Text="Quiz *">
            <RadzenDropDown TValue="string" @key="quizPickerVersion" Data="@quizOptions"
                            TextProperty="@nameof(QuizOption.Title)" ValueProperty="@nameof(QuizOption.Value)"
                            Value="@SelectedQuiz" Change="SelectQuizAsync" Placeholder="Vælg en quiz" />
        </RadzenFormField>
        @if (Model.NewQuiz != null)
        {
            <RadzenText Text="@($"Ny quizkladde: {Model.NewQuiz.Title}")" />
        }
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Subtitle1" Text="Emner" />
        @for (var index = 0; index < Model.Topics.Count; index++)
        {
            var topicIndex = index;
            var topic = Model.Topics[topicIndex];
            <RadzenCard @key="topicIndex" Variant="Variant.Outlined">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
                    <RadzenText Text="@topic.Title" />
                    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap">
                        <RadzenButton Text="Redigér" Icon="edit" Variant="Variant.Outlined"
                                      Click="@(() => OpenTopic(topicIndex))" />
                        <RadzenButton Text="Fjern" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                      Click="@(() => Model.Topics.RemoveAt(topicIndex))" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        }
        <RadzenButton Text="Tilføj emne" Icon="add" Click="@(() => OpenTopic())" />
    }
</RadzenStack>

@code {
    [Parameter, EditorRequired]
    public ExhibitionSubjectInputModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ExhibitionName { get; set; } = string.Empty;

    private string Id { get; } = $"subject-{Guid.NewGuid():N}";
    private int quizPickerVersion;

    private const string CreateNew = "new";

    private IReadOnlyList<QuizOption> quizOptions = [new(CreateNew, "Lav en ny quiz")];
    private bool quizOptionsLoaded;
    private bool quizOptionsLoading;
    private bool quizOptionsError;

    protected override Task OnParametersSetAsync() => LoadQuizOptionsAsync();

    private async Task LoadQuizOptionsAsync()
    {
        if (!Model.IsQuiz || quizOptionsLoaded || quizOptionsLoading)
        {
            return;
        }

        quizOptionsLoading = true;
        quizOptionsError = false;
        try
        {
            var quizzes = await QuizService.GetPublishedAsync();
            quizOptions = quizzes.OrderBy(quiz => quiz.Title)
                .Select(quiz => new QuizOption(quiz.Id.ToString(), quiz.Title))
                .Append(new QuizOption(CreateNew, "Lav en ny quiz"))
                .ToArray();
            quizOptionsLoaded = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException
            or OperationCanceledException)
        {
            quizOptionsError = true;
        }
        finally
        {
            quizOptionsLoading = false;
        }
    }

    private string? SelectedQuiz => Model.QuizId?.ToString();

    private async Task SelectQuizAsync(object? value)
    {
        if (value is string option && option == CreateNew)
        {
            object? result = await Dialog.OpenAsync<ExhibitionQuizDraftDialog>(
                "Opret quiz",
                new Dictionary<string, object?>
                {
                    [nameof(ExhibitionQuizDraftDialog.ExhibitionName)] = ExhibitionName
                },
                new DialogOptions { Width = "min(92vw, 900px)", CloseDialogOnOverlayClick = false });

            if (result is QuizInputModel draft)
            {
                Model.NewQuiz = draft;
                Model.QuizId = null;
            }

            quizPickerVersion++;
        }
        else if (value is string quizId && Guid.TryParse(quizId, out var id))
        {
            Model.QuizId = id;
            Model.NewQuiz = null;
        }
    }

    private sealed record QuizOption(string Value, string Title);

    private async Task OpenTopic(int? index = null)
    {
        var draft = new ExhibitionTopicInputModel();
        if (index is int existingIndex)
        {
            draft = Model.Topics[existingIndex] with { };
        }

        object? result = await Dialog.OpenAsync<ExhibitionTopicDialogComponent>(
            index.HasValue ? "Redigér emne" : "Tilføj emne",
            new Dictionary<string, object?>
            {
                [nameof(ExhibitionTopicDialogComponent.Model)] = draft,
                [nameof(ExhibitionTopicDialogComponent.SubjectTitle)] = Model.Title
            },
            new DialogOptions { Width = "min(92vw, 560px)", CloseDialogOnOverlayClick = false });

        if (result is ExhibitionTopicInputModel topic)
        {
            if (index is int topicIndex)
            {
                Model.Topics[topicIndex] = topic;
            }
            else
            {
                Model.Topics.Add(topic);
            }
        }
    }
}

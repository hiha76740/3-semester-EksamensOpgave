@inject DialogService Dialog

<RadzenTemplateForm TItem="ExhibitionInputModel" Data="@model" Submit="Continue">
    <RadzenStack Gap="1rem">
        <RadzenFormField Text="Udstillingsnavn (DA) *">
            <RadzenTextBox Name="ExhibitionName" @bind-Value="model.ExhibitionName" />
        </RadzenFormField>
        <RadzenFormField Text="Udstillingsnavn (EN) *">
            <RadzenTextBox @bind-Value="model.ExhibitionNameEn" />
        </RadzenFormField>
        @if (showError)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">Skriv udstillingsnavnet på dansk og engelsk.</RadzenAlert>
        }
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Annullér" Variant="Variant.Outlined" Click="@(() => Dialog.Close())" />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Fortsæt" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private readonly ExhibitionInputModel model = new();
    private bool showError;

    private void Continue(ExhibitionInputModel input)
    {
        showError = string.IsNullOrWhiteSpace(input.ExhibitionName) || string.IsNullOrWhiteSpace(input.ExhibitionNameEn);
        if (!showError)
        {
            Dialog.Close(input);
        }
    }
}

@page "/user/profile"
@page "/users/{UserId:guid}/edit"
@inject IAuthorizationService Authorization

@inject IAuthUserService AuthUsers
@inject IUserService Users
@inject CustomAuthenticationStateProvider AuthStateProvider

<PageTitle>@Title</PageTitle>

<RadzenCard class="rz-mx-auto rz-my-4" Style="max-width: 42rem;">
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H2" Text="@Title" />
        <AuthorizeView>
            <Authorized>
                @if (!canAccess)
                {
                    <RadzenText Text="Du har ikke rettighed til at ændre denne bruger." />
                }
                else
                {
                    @if (UserId.HasValue)
                    {
                        <RadzenLink Path="users" Text="Tilbage til brugere" Icon="arrow_back" />
                    }
                    @if (error != null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</RadzenAlert>
                    }
                    @if (message != null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false">@message</RadzenAlert>
                    }

                    @if (isLoading)
                    {
                        <RadzenText role="status" Text="Henter profil …" />
                    }
                    else if (profile == null || account == null)
                    {
                        <RadzenButton Text="Hent profil igen" Click="LoadProfileAsync" />
                    }
                    else
                    {
                        <UserProfileFormComponent Model="model" IsBusy="isSaving" RequireCurrentPassword="@(!UserId.HasValue)"
                                                  SaveName="SaveNameAsync" SaveEmail="SaveEmailAsync"
                                                  SavePassword="SavePasswordAsync" />
                        <RadzenButton Text="Genindlæs profil" Variant="Variant.Text"
                                      Click="LoadProfileAsync" Disabled="@isSaving" />
                    }
                }
            </Authorized>
            <NotAuthorized>
                <RadzenLink Path="login" Text="Log ind for at se din profil" />
            </NotAuthorized>
            <Authorizing>
                <RadzenText Text="Kontrollerer login …" />
            </Authorizing>
        </AuthorizeView>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter]
    public Guid? UserId { get; set; }

    private string Title => UserId.HasValue ? "Ændre bruger" : "Min profil";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private UserProfileInputModel model = new();
    private UserResponse? profile;
    private AuthUserResponse? account;
    private string? error;
    private string? message;
    private bool isLoading;
    private bool isSaving;

    private bool canAccess;

    protected override async Task OnParametersSetAsync()
    {
        canAccess = false;
        profile = null;
        account = null;
        model = new UserProfileInputModel();

        if (AuthenticationStateTask == null)
        {
            return;
        }

        var state = await AuthenticationStateTask;
        canAccess = state.User.Identity?.IsAuthenticated == true
            && (!UserId.HasValue || (await Authorization.AuthorizeAsync(state.User, "User.Edit")).Succeeded);
        if (canAccess)
        {
            await LoadProfileAsync();
        }
    }

    private Task<AuthUserResponse> LoadAccountAsync() =>
        UserId is Guid id ? AuthUsers.GetByIdAsync(id) : AuthUsers.GetAuthUserAsync();

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        error = null;
        message = null;
        try
        {
            var currentAccount = await LoadAccountAsync();
            var currentProfile = await Users.GetByIdAsync(currentAccount.Id);
            account = currentAccount;
            profile = currentProfile;
            model = new UserProfileInputModel
            {
                Firstname = currentProfile.Firstname,
                Surname = currentProfile.Surname,
                Email = currentAccount.Email
            };
        }
        catch (Exception exception) when (IsServiceError(exception))
        {
            error = "Profilen kunne ikke hentes.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SaveNameAsync() => SaveAsync(async () =>
    {
        var currentProfile = profile;
        if (currentProfile == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(model.Firstname) || string.IsNullOrWhiteSpace(model.Surname))
        {
            error = "Udfyld både fornavn og efternavn.";
            return;
        }

        var updated = await Users.UpdateAsync(currentProfile.Id,
            new UpdateUserRequest(model.Firstname.Trim(), model.Surname.Trim(), currentProfile.RowVersion));
        profile = updated;
        model.Firstname = updated.Firstname;
        model.Surname = updated.Surname;
        message = "Navnet er gemt.";
    });

    private Task SaveEmailAsync() => SaveAsync(async () =>
    {
        var currentAccount = account;
        if (currentAccount == null)
        {
            return;
        }

        var email = model.Email.Trim();
        if (!new EmailAddressAttribute().IsValid(email) || email.Length == 0)
        {
            error = "Indtast en gyldig e-mailadresse.";
            return;
        }

        if (string.Equals(email, currentAccount.Email, StringComparison.OrdinalIgnoreCase))
        {
            model.Email = currentAccount.Email;
            message = "E-mailadressen er allerede gemt.";
            return;
        }

        var updated = await AuthUsers.UpdateEmailAsync(currentAccount.Id,
            new UpdateAuthUserEmailRequest(email, currentAccount.RowVersion));
        account = currentAccount with { Email = updated.Email, RowVersion = updated.RowVersion };
        model.Email = updated.Email;
        message = "E-mailadressen er gemt.";
        if (!UserId.HasValue)
        {
            await AuthStateProvider.RefreshAuthenticationState();
        }
    });

    private Task SavePasswordAsync() => SaveAsync(async () =>
    {
        var currentAccount = account;
        if (currentAccount == null)
        {
            return;
        }

        if ((!UserId.HasValue && string.IsNullOrWhiteSpace(model.CurrentPassword))
            || string.IsNullOrWhiteSpace(model.NewPassword))
        {
            error = UserId.HasValue
                ? "Indtast en ny adgangskode."
                : "Indtast din nuværende adgangskode og en ny adgangskode.";
            return;
        }

        if (!string.Equals(model.NewPassword, model.ConfirmPassword, StringComparison.Ordinal))
        {
            error = "De to nye adgangskoder skal være ens.";
            return;
        }

        if (UserId.HasValue)
        {
            await AuthUsers.ResetPasswordAsync(currentAccount.Id,
                new ResetUserPasswordRequest(model.NewPassword, currentAccount.RowVersion));
        }
        else
        {
            await AuthUsers.UpdatePasswordAsync(currentAccount.Id,
                new UpdateAuthUserPasswordRequest(model.NewPassword, model.CurrentPassword, currentAccount.RowVersion));
        }

        model.CurrentPassword = string.Empty;
        model.NewPassword = string.Empty;
        model.ConfirmPassword = string.Empty;
        message = "Adgangskoden er ændret.";

        account = null;
        account = await LoadAccountAsync();
    });

    private async Task SaveAsync(Func<Task> save)
    {
        if (isSaving || isLoading)
        {
            return;
        }

        isSaving = true;
        error = null;
        message = null;
        try
        {
            await save();
        }
        catch (Exception exception) when (IsServiceError(exception))
        {
            error = "Profilen kunne ikke opdateres. Kontrollér oplysningerne, eller genindlæs profilen og prøv igen.";
            if (message != null)
            {
                error = "Ændringen er gemt, men profilen kunne ikke opdateres i visningen. Genindlæs profilen.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private static bool IsServiceError(Exception exception) =>
        exception is HttpRequestException or JsonException or InvalidOperationException or OperationCanceledException;
}

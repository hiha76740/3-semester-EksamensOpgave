@page "/exhibition/create"

@using System.Text.Json

@inject DialogService Dialog

<PageTitle>Opret udstilling</PageTitle>

@if (model != null)
{
    <ExhibitionFormComponent Model="model" SubmitCallback="ShowRequest" Error="@error" />
}
else
{
    <RadzenButton Text="Opret udstilling" Icon="add" Click="NameExhibitionAsync" />
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = true
    };

    private ExhibitionInputModel? model;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await NameExhibitionAsync();
            StateHasChanged();
        }
    }

    private async Task NameExhibitionAsync()
    {
        object? result = await Dialog.OpenAsync<ExhibitionNameDialogComponent>(
            "Opret udstilling",
            options: new DialogOptions { Width = "min(92vw, 420px)", CloseDialogOnOverlayClick = false });

        if (result is ExhibitionInputModel exhibition)
        {
            model = exhibition;
            error = null;
        }
    }

    private async Task ShowRequest(ExhibitionInputModel input)
    {
        error = null;

        for (var i = 0; i < input.Subjects.Count; i++)
        {
            var subject = input.Subjects[i];
            if (string.IsNullOrWhiteSpace(subject.Title) || string.IsNullOrWhiteSpace(subject.TitleEn)
                || string.IsNullOrWhiteSpace(subject.Description) || string.IsNullOrWhiteSpace(subject.DescriptionEn))
            {
                error = $"Udfyld titel og beskrivelse på begge sprog for subject {i + 1}.";
                return;
            }

            if (subject.IsQuiz && subject.QuizId == null && subject.NewQuiz == null)
            {
                error = $"Vælg eller opret en quiz for subject {i + 1}.";
                return;
            }

            if (!subject.IsQuiz && subject.Topics.Count == 0)
            {
                error = $"Tilføj mindst ét emne til subject {i + 1}.";
                return;
            }
        }

        var request = new
        {
            name = Localized(input.ExhibitionName, input.ExhibitionNameEn),
            subjects = input.Subjects.Select(subject => new
            {
                title = Localized(subject.Title, subject.TitleEn),
                description = Localized(subject.Description, subject.DescriptionEn),
                type = subject.IsQuiz ? "quiz" : "content",
                topics = subject.IsQuiz ? null : subject.Topics.Select(topic => new
                {
                    title = Localized(topic.Title, topic.TitleEn),
                    description = Localized(topic.Description, topic.DescriptionEn),
                    body = Localized(topic.Body, topic.BodyEn),
                    calloutLabel = Localized(topic.CalloutLabel, topic.CalloutLabelEn),
                    calloutText = Localized(topic.CalloutText, topic.CalloutTextEn),
                    quote = Localized(topic.Quote, topic.QuoteEn)
                }),
                quizId = subject.IsQuiz ? subject.QuizId : null,
                newQuiz = subject.IsQuiz && subject.NewQuiz is QuizInputModel quiz ? new
                {
                    title = Localized(quiz.Title, quiz.TitleEn),
                    instruction = Localized(quiz.Instruction, quiz.InstructionEn),
                    questions = quiz.Questions.Select(question => new
                    {
                        text = Localized(question.Text, question.TextEn),
                        choices = question.Answers.Select(answer => new
                        {
                            text = Localized(answer.Text, answer.TextEn),
                            feedback = Localized(answer.Feedback, answer.FeedbackEn),
                            correctAnswer = answer.IsCorrect
                        })
                    })
                } : null
            })
        };

        var json = JsonSerializer.Serialize(request, JsonOptions);
        await Dialog.OpenAsync("Eksempel på request", _ => @<RadzenStack Gap="1rem">
            <RadzenText Text="Frontend-prototype. Eksemplet gemmes ikke." />
            <RadzenTextArea Value="@json" ReadOnly="true" Rows="22" Style="width: 100%;" />
        </RadzenStack>, new DialogOptions { Width = "min(92vw, 800px)" });
    }

    private static Dictionary<string, string> Localized(string danish, string english)
    {
        return new Dictionary<string, string>
        {
            ["da"] = danish.Trim(),
            ["en"] = english.Trim()
        };
    }
}

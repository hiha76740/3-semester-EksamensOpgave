@page "/exhibition/create"

@inject IImageService ImageService
@inject IExhibitionService ExhibitionService
@inject DialogService Dialog
@inject NavigationManager NavigationManager

<PageTitle>Opret udstilling</PageTitle>

@if (model != null)
{
    <ExhibitionFormComponent Model="model"
                             SubmitCallback="Create"
                             Error="@error"
                             SubmitButtonText="@submitButtonText" />
}
else
{
    <RadzenButton Text="Opret udstilling" Icon="add" Click="NameExhibitionAsync" />
}

@code {
    private string submitButtonText = "Opret";

    private ExhibitionInputModel? model;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await NameExhibitionAsync();
            StateHasChanged();
        }
    }

    private async Task NameExhibitionAsync()
    {
        object? result = await Dialog.OpenAsync<ExhibitionNameDialogComponent>(
            "Opret udstilling",
            options: new DialogOptions { Width = "min(92vw, 420px)", CloseDialogOnOverlayClick = false });

        if (result is ExhibitionInputModel exhibition)
        {
            model = exhibition;
            error = null;
        }
    }

    public async Task Create(ExhibitionInputModel input)
    {
        if (input.ThemeFile == null)
        {
            error = "Venligst tilføj tema billede fil";
        }
        else
        {
            error = null;

            for (var i = 0; i < input.Subjects.Count; i++)
            {
                var subject = input.Subjects[i];
                if (string.IsNullOrWhiteSpace(subject.Title) || string.IsNullOrWhiteSpace(subject.TitleEn)
                    || string.IsNullOrWhiteSpace(subject.Description) || string.IsNullOrWhiteSpace(subject.DescriptionEn))
                {
                    error = $"Udfyld titel og beskrivelse på begge sprog for subject {i + 1}.";
                    return;
                }

                if (subject.IsQuiz && subject.QuizId == null && subject.NewQuiz == null)
                {
                    error = $"Vælg eller opret en quiz for subject {i + 1}.";
                    return;
                }

                if (!subject.IsQuiz && subject.Topics.Count == 0)
                {
                    error = $"Tilføj mindst ét emne til subject {i + 1}.";
                    return;
                }
            }

            var imageResponse = await ImageService.UploadImage(input.ThemeFile, ExhibitionInputModel.MaxThemeFileSize);

            var request = new CreateExhibitionRequest(
                input.ExhibitionName,
                input.ExhibitionNameEn,
                imageResponse.ImageId,
                input.Subjects.Select(s => new CreateSubjectRequest(
                    s.Title,
                    s.TitleEn,
                    s.Title.ToLower(),
                    s.Description,
                    s.DescriptionEn,
                    s.Topics.Select(t => new CreateTopicRequest(
                        t.Title,
                        t.TitleEn,
                        t.Description,
                        t.DescriptionEn,
                        t.Body,
                        t.BodyEn,
                        t.CalloutLabel,
                        t.CalloutLabelEn,
                        t.CalloutText,
                        t.CalloutTextEn,
                        t.Quote,
                        t.QuoteEn)).ToList()
                )).ToList()
            );

            var statusCode = await ExhibitionService.CreateAsync(request);

            if (statusCode == HttpStatusCode.Created)
            {
                await Dialog.Alert("Udstilling oprettet", "Udstilling oprettelse");
                NavigationManager.NavigateTo("/exhibitions");
            }
            else
            {
                error = "Fejl opstået ved oprettelse af udstilling. Prøv igen";
            }
        }
        
    }
}

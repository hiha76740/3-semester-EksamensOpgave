@page "/games/create"
@using VidensVejen.ContractsLib.Responses.ExhibitionService
@using VidensVejen.Web.Controls.Games
@using VidensVejen.Web.Models
@using VidensVejen.Web.Models.Games
@inject IExhibitionService exhibitionService

<PageTitle>Opret quiz</PageTitle>

@if (exhibitionsError != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">@exhibitionsError</RadzenAlert>
}

<QuizFormComponent @key="model" Model="model"
                   Exhibitions="exhibitions"
                   FormTitle="Opret quiz"
                   SubmitText="Kontrollér kladde"
                   SubmitCallback="CheckDraft"
                   ResetCallback="ResetForm"
                   Changed="ClearMessages"
                   Message="@message"
                   Errors="errors" />

@code {
    private QuizInputModel model = new();
    private readonly List<string> errors = [];
    private string? message;

    private IReadOnlyList<ExhibitionNameResponse> exhibitions = [];
    private string? exhibitionsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // var options = await exhibitionService.GetAllNamesAsync();

            // TODO: remove and call database
            var options = new List<ExhibitionNameResponse>
            {
                new ExhibitionNameResponse(Guid.NewGuid(), "Test 1"),
                new ExhibitionNameResponse(Guid.NewGuid(), "Test 2")
            };

            exhibitions = options.Where(option => option.Id != Guid.Empty).ToList();
            if (options.Count > 0 && exhibitions.Count == 0)
            {
                exhibitionsError = "Udstillingslisten mangler udstillingernes id'er.";
            }
            else if (exhibitions.Count == 0)
            {
                exhibitionsError = "Der er ingen udstillinger at vælge.";
            }
        }
        catch (HttpRequestException)
        {
            exhibitionsError = "Udstillingerne kunne ikke hentes.";
        }
        catch (System.Text.Json.JsonException)
        {
            exhibitionsError = "Udstillingslisten kunne ikke læses.";
        }
    }

    private void CheckDraft(QuizInputModel submittedModel)
    {
        ClearMessages();

        if (string.IsNullOrWhiteSpace(submittedModel.Title))
        {
            errors.Add("Quizzen skal have en titel.");
        }

        if (string.IsNullOrWhiteSpace(submittedModel.Instruction))
        {
            errors.Add("Quizzen skal have en instruktion.");
        }

        if (!exhibitions.Any(option => option.Id == submittedModel.ExhibitionId))
        {
            errors.Add("Vælg en udstilling til quizzen.");
        }

        for (var i = 0; i < submittedModel.Questions.Count; i++)
        {
            var question = submittedModel.Questions[i];

            if (string.IsNullOrWhiteSpace(question.Text))
            {
                errors.Add($"Spørgsmål {i + 1} mangler en tekst.");
            }

            if (question.Answers.Count < 2)
            {
                errors.Add($"Spørgsmål {i + 1} skal have mindst to svar.");
            }

            if (question.Answers.Count(answer => answer.IsCorrect) != 1)
            {
                errors.Add($"Spørgsmål {i + 1} skal have præcis ét korrekt svar.");
            }

            for (var j = 0; j < question.Answers.Count; j++)
            {
                if (string.IsNullOrWhiteSpace(question.Answers[j].Text))
                {
                    errors.Add($"Spørgsmål {i + 1}, svar {j + 1} mangler svartekst.");
                }
            }
        }

        if (errors.Count == 0)
        {
            message = "Quizzen er udfyldt korrekt og har status Kladde. Den er endnu ikke gemt i en database.";
        }
    }

    private void ResetForm()
    {
        model = new QuizInputModel();
        ClearMessages();
    }

    private void ClearMessages()
    {
        message = null;
        errors.Clear();
    }
}

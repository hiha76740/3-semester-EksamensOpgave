@page "/games/create"
@using VidensVejen.ContractsLib.Requests.GameService.Drafts
@using VidensVejen.ContractsLib.Requests.GameService.Quizzes


@inject IExhibitionService ExhibitionService
@inject IQuizService QuizService

<PageTitle>Opret quiz</PageTitle>

@if (exhibitionsError != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">@exhibitionsError</RadzenAlert>
}

@if (model != null)
{
    <QuizFormComponent @key="model" Model="model"
                       Exhibitions="exhibitions"
                       FormTitle="Opret quiz"
                       SubmitText="Publicér"
                       SaveDraftCallback="SaveDraftAsync" IsBusy="isBusy"
                       SubmitCallback="Create"
                       ResetCallback="ResetForm"
                       Changed="ClearMessages"
                       Message="@message"
                       Errors="errors" />
}
else
{
    @if (message != null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false">@message</RadzenAlert>
    }
    @if (errors.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@errors[0]</RadzenAlert>
    }
    <RadzenButton Text="Opret quiz" Icon="add" Click="StartDraftAsync" IsBusy="@isBusy" />
}

@code {
    private QuizInputModel? model;
    private Guid? draftId;
    private bool isBusy;
    private readonly List<string> errors = [];
    private string? message;

    private IReadOnlyList<ExhibitionNameResponse> exhibitions = [];
    private string? exhibitionsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var options = await ExhibitionService.GetAllNamesAsync();

            exhibitions = options.Where(option => option.Id != Guid.Empty).ToList();
            if (options.Count > 0 && exhibitions.Count == 0)
            {
                exhibitionsError = "Udstillingslisten mangler udstillingernes id'er.";
            }
            else if (exhibitions.Count == 0)
            {
                exhibitionsError = "Der er ingen udstillinger at vælge.";
            }
        }
        catch (HttpRequestException)
        {
            exhibitionsError = "Udstillingerne kunne ikke hentes.";
        }
        catch (System.Text.Json.JsonException)
        {
            exhibitionsError = "Udstillingslisten kunne ikke læses.";
        }
    }

    private Task StartDraftAsync() => RunAsync(async () =>
    {
        draftId = await QuizService.CreateDraftAsync();
        model = new QuizInputModel();
    }, "Quizkladden kunne ikke oprettes.");

    private Task SaveDraftAsync(QuizInputModel input) => RunAsync(async () =>
    {
        if (draftId is Guid id)
        {
            await QuizService.SaveDraftAsync(id, BuildDraftRequest(input));
            message = "Quizkladden er gemt.";
        }
    }, "Quizkladden kunne ikke gemmes.");

    private Task Create(QuizInputModel input) => RunAsync(async () =>
    {

        if (string.IsNullOrWhiteSpace(input.Title) || string.IsNullOrWhiteSpace(input.TitleEn))
        {
            errors.Add("Quizzen skal have en titel på dansk og engelsk.");
        }

        if (string.IsNullOrWhiteSpace(input.Instruction) || string.IsNullOrWhiteSpace(input.InstructionEn))
        {
            errors.Add("Quizzen skal have en instruktion på dansk og engelsk.");
        }

        if (!exhibitions.Any(option => option.Id == input.ExhibitionId))
        {
            errors.Add("Vælg en udstilling til quizzen.");
        }

        if (string.IsNullOrWhiteSpace(input.QuizLayout))
        {
            errors.Add("Vælg et layout til quizzen.");
        }

        for (var i = 0; i < input.Questions.Count; i++)
        {
            var question = input.Questions[i];

            if (string.IsNullOrWhiteSpace(question.Text) || string.IsNullOrWhiteSpace(question.TextEn))
            {
                errors.Add($"Spørgsmål {i + 1} skal have tekst på dansk og engelsk.");
            }

            if (question.Answers.Count < 2)
            {
                errors.Add($"Spørgsmål {i + 1} skal have mindst to svar.");
            }

            if (question.Answers.Count(answer => answer.IsCorrect) != 1)
            {
                errors.Add($"Spørgsmål {i + 1} skal have præcis ét korrekt svar.");
            }

            for (var j = 0; j < question.Answers.Count; j++)
            {
                if (string.IsNullOrWhiteSpace(question.Answers[j].Text) || string.IsNullOrWhiteSpace(question.Answers[j].TextEn))
                {
                    errors.Add($"Spørgsmål {i + 1}, svar {j + 1} skal have svartekst på dansk og engelsk.");
                }
            }
        }

        if (errors.Count != 0 || draftId == null)
        {
            return;
        }

        var status = await QuizService.PublishAsync(draftId.Value, BuildRequest(input));
        if (status == HttpStatusCode.OK || status == HttpStatusCode.Created)
        {
            draftId = null;
            model = null;
            message = "Quizzen er publiceret.";
        }
        else
        {
            errors.Add($"Quizzen kunne ikke publiceres (HTTP {(int)status}).");
        }
    }, "Publiceringen kunne ikke bekræftes.");

    private static CreateQuizRequest BuildRequest(QuizInputModel input) =>
        new(input.DraftId, input.Title, input.TitleEn, input.ExhibitionId.GetValueOrDefault(), input.QuizLayout,
            input.Questions.Select(question => new CreateQuestionRequest(
                question.Text, question.TextEn,
                question.Answers.Select(answer => new CreateChoiceRequest(
                    answer.Text, answer.TextEn, answer.IsCorrect,
                    answer.Feedback, answer.FeedbackEn)).ToList())).ToList(),
            input.EndMessage, input.EndMessageEn, input.Instruction, input.InstructionEn);

    private static UpdateQuizDraftRequest BuildDraftRequest(QuizInputModel input) =>
        new(input.Title, input.TitleEn, input.ExhibitionId, input.QuizLayout,
            input.Questions.Select(question => new UpdateQuestionDraftRequest(
                question.Text, question.TextEn,
                question.Answers.Select(answer => new UpdateChoiceDraftRequest(
                    answer.Text, answer.TextEn, answer.IsCorrect,
                    answer.Feedback, answer.FeedbackEn)).ToList())).ToList(),
            input.EndMessage, input.EndMessageEn, input.Instruction, input.InstructionEn);

    private async Task RunAsync(Func<Task> action, string failureMessage)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        ClearMessages();
        try
        {
            await action();
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException
            or OperationCanceledException)
        {
            errors.Add(failureMessage);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetForm()
    {
        model = new QuizInputModel();
        ClearMessages();
    }

    private void ClearMessages()
    {
        message = null;
        errors.Clear();
    }
}

@page "/games/create"
@page "/games/drafts/{ExistingDraftId:guid}"
@page "/games/{PublishedQuizId:guid}/edit"
@attribute [Authorize(Policy = "Games.Editor")]


@inject IExhibitionService ExhibitionService
@inject IQuizService QuizService
@inject NavigationManager Navigation

<PageTitle>@FormTitle</PageTitle>
<RadzenLink Text="Tilbage til quizzer" Icon="arrow_back" Path="games" />

@if (exhibitionsError != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">@exhibitionsError</RadzenAlert>
}

@if (accessDenied)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false">Du har ikke adgang til denne handling.</RadzenAlert>
}
else if (model is { } readOnlyModel && !canEdit)
{
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.H2" Text="@readOnlyModel.Title" />
        <RadzenText Text="@readOnlyModel.Instruction" />
        @foreach (var question in readOnlyModel.Questions)
        {
            <RadzenCard>
                <RadzenText Text="@question.Text" />
                @foreach (var answer in question.Answers)
                {
                    <RadzenText Text="@answer.Text" />
                }
            </RadzenCard>
        }
        @foreach (var error in errors)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</RadzenAlert>
        }
        <RadzenButton Text="Publicér" Click="@(() => Create(readOnlyModel))" IsBusy="@isBusy" />
    </RadzenStack>
}
else if (model != null)
{
    <QuizFormComponent @key="model" Model="model"
                       Exhibitions="exhibitions"
                       FormTitle="@FormTitle" CanSubmit="@canPublish"
                       SubmitText="Publicér"
                       SaveDraftCallback="SaveDraftAsync" IsBusy="isBusy"
                       SubmitCallback="Create"
                       ResetCallback="ResetForm" ResetText="@ResetText"
                       Changed="ClearMessages"
                       Message="@message"
                       Errors="errors" />
}
else
{
    @if (message != null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" AllowClose="false">@message</RadzenAlert>
    }
    @if (errors.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@errors[0]</RadzenAlert>
    }
    @if (canEdit && !ExistingDraftId.HasValue && !PublishedQuizId.HasValue)
    {
        if (isBusy)
        {
            <RadzenText role="status" Text="Opretter quizkladde …" />
        }
        else if (errors.Count > 0)
        {
            <RadzenButton Text="Prøv igen" Click="StartDraftAsync" />
        }
    }
}

@code {
    [Parameter] public Guid? ExistingDraftId { get; set; }
    [Parameter] public Guid? PublishedQuizId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool canEdit;
    private bool canPublish;
    private bool accessDenied;
    private string FormTitle => PublishedQuizId.HasValue ? "Ny kladde fra publiceret quiz"
        : ExistingDraftId.HasValue ? "Quizkladde" : "Opret quiz";

    private string ResetText => ExistingDraftId.HasValue || PublishedQuizId.HasValue ? "Luk" : "Nulstil";

    private QuizInputModel? model;
    private Guid? draftId;
    private bool isBusy;
    private bool draftVersionNeedsReload;
    private readonly List<string> errors = [];
    private string? message;

    private IReadOnlyList<ExhibitionNameResponse> exhibitions = [];
    private string? exhibitionsError;

    private (Guid? DraftId, Guid? PublishedId)? loadedRoute;

    protected override async Task OnParametersSetAsync()
    {
        var route = (ExistingDraftId, PublishedQuizId);
        if (loadedRoute == route)
        {
            return;
        }

        model = null;
        draftId = null;
        draftVersionNeedsReload = false;
        exhibitionsError = null;
        ClearMessages();

        var authentication = AuthenticationStateTask;
        if (authentication == null)
        {
            accessDenied = true;
            return;
        }

        var user = (await authentication).User;
        canEdit = user.Identity?.IsAuthenticated == true && user.HasClaim(CustomClaimTypes.Permission, "Game.Edit");
        canPublish = user.Identity?.IsAuthenticated == true && user.HasClaim(CustomClaimTypes.Permission, "Game.Publish");
        accessDenied = !canEdit && !(canPublish && ExistingDraftId.HasValue);
        if (accessDenied)
        {
            return;
        }

        loadedRoute = route;

        if (ExistingDraftId is Guid id)
        {
            await RunAsync(async () =>
            {
                var draft = await QuizService.GetDraftAsync(id);
                draftId = draft.Id;
                model = QuizEditorMapper.FromDraft(draft);
                model.RowVersion = draft.RowVersion;
            }, "Quizkladden kunne ikke hentes.");
        }
        else if (PublishedQuizId is Guid quizId)
        {
            await RunAsync(async () =>
            {
                model = QuizEditorMapper.FromPublished(await QuizService.GetPublishedAsync(quizId));
                message = "Gem en kladde for at arbejde videre med en ny version af quizzen.";
            }, "Quizzen kunne ikke hentes.");
        }
        else
        {
            await StartDraftAsync();
        }

        try
        {
            var options = await ExhibitionService.GetAllNamesAsync();

            exhibitions = options.Where(option => option.Id != Guid.Empty).ToList();
            if (options.Count > 0 && exhibitions.Count == 0)
            {
                exhibitionsError = "Udstillingslisten mangler udstillingernes id'er.";
            }
            else if (exhibitions.Count == 0)
            {
                exhibitionsError = "Der er ingen udstillinger at vælge.";
            }
        }
        catch (HttpRequestException)
        {
            exhibitionsError = "Udstillingerne kunne ikke hentes.";
        }
        catch (System.Text.Json.JsonException)
        {
            exhibitionsError = "Udstillingslisten kunne ikke læses.";
        }
    }

    private Task StartDraftAsync() => RunAsync(async () =>
    {
        if (!canEdit)
        {
            return;
        }

        var input = new QuizInputModel();
        await EnsureDraftAsync(input);
        model = input;
    }, "Quizkladden kunne ikke oprettes.");

    private Task SaveDraftAsync(QuizInputModel input) => RunAsync(async () =>
    {
        if (!canEdit)
        {
            return;
        }

        if (!await EnsureDraftAsync(input))
        {
            return;
        }

        var id = draftId.GetValueOrDefault();
        await QuizService.SaveDraftAsync(id, QuizEditorMapper.BuildDraftRequest(input));

        draftVersionNeedsReload = true;
        message = "Quizkladden er gemt.";
        await LoadDraftVersionAsync(id, input);
        draftVersionNeedsReload = false;
    }, "Quizkladden kunne ikke gemmes.");

    private Task Create(QuizInputModel input) => RunAsync(async () =>
    {
        if (!canPublish)
        {
            return;
        }

        QuizEditorMapper.ValidatePublication(input, errors);

        if (errors.Count != 0)
        {
            return;
        }

        if (!await EnsureDraftAsync(input))
        {
            return;
        }

        var id = draftId.GetValueOrDefault();
        await QuizService.PublishAsync(id, QuizEditorMapper.BuildRequest(id, input));
        draftId = null;
        model = null;
        message = "Quizzen er publiceret.";
    }, "Publiceringen kunne ikke bekræftes.");

    private async Task<bool> EnsureDraftAsync(QuizInputModel input)
    {
        if (draftVersionNeedsReload)
        {
            errors.Add("Åbn quizkladden igen fra oversigten for at fortsætte.");
            return false;
        }

        var id = draftId ??= await QuizService.CreateDraftAsync();
        if (input.RowVersion.Length == 0)
        {
            await LoadDraftVersionAsync(id, input);
        }

        return true;
    }

    private async Task LoadDraftVersionAsync(Guid id, QuizInputModel input)
    {
        var draft = await QuizService.GetDraftAsync(id);
        if (draft.RowVersion.Length == 0)
        {
            throw new System.Text.Json.JsonException("The quiz draft response is missing its row version.");
        }

        input.RowVersion = draft.RowVersion;
    }

    private async Task RunAsync(Func<Task> action, string failureMessage)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        ClearMessages();
        try
        {
            await action();
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException
            or OperationCanceledException)
        {
            if (draftVersionNeedsReload)
            {
                errors.Add("Kladdens nye version kunne ikke hentes. Åbn kladden igen fra oversigten.");
            }
            else
            {
                errors.Add(failureMessage);
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetForm()
    {
        if (ExistingDraftId.HasValue || PublishedQuizId.HasValue)
        {
            Navigation.NavigateTo("games");
            return;
        }

        model = new QuizInputModel { RowVersion = model?.RowVersion ?? [] };
        ClearMessages();
    }

    private void ClearMessages()
    {
        message = null;
        errors.Clear();
    }
}

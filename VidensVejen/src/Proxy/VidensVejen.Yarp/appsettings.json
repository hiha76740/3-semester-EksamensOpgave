{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "YARP": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth-api"
          }
        ]
      },
      "permissions-route": {
        "ClusterId": "permissions-cluster",
        "Match": {
          "Path": "/permissions-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/permissions-api"
          }
        ]
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/users-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users-api"
          }
        ]
      },
      "exhibitions-route": {
        "ClusterId": "exhibitions-cluster",
        "Match": {
          "Path": "/exhibitions-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/exhibitions-api"
          }
        ]
      },
      "quizzes-route": {
        "ClusterId": "quizzes-cluster",
        "Match": {
          "Path": "/quizzes-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/quizzes-api"
          }
        ]
      },
      "images-route": {
        "ClusterId": "images-cluster",
        "Match": {
          "Path": "/images-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/images-api"
          }
        ]
      },
      "theme-images-route": {
        "ClusterId": "theme-images-cluster",
        "Match": {
          "Path": "/images/themes/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/images/themes"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://VidensVejen-AuthService:8080/v1/auth"
          }
        }
      },
      "permissions-cluster": {
        "Destinations": {
          "permissions-destination": {
            "Address": "http://VidensVejen-AuthService:8080/v1/permissions"
          }
        }
      },
      "users-cluster": {
        "Destinations": {
          "users-destination": {
            "Address": "http://VidensVejen-UserService:8080/v1/users"
          }
        }
      },
      "exhibitions-cluster": {
        "Destinations": {
          "exhibitions-destination": {
            "Address": "http://VidensVejen-ExhibitionService:8080/api/exhibitions"
          }
        }
      },
      "quizzes-cluster": {
        "Destinations": {
          "quizzes-destination": {
            "Address": "http://VidensVejen-GameService:8080/v1/games/quizzes"
          }
        }
      },
      "images-cluster": {
        "Destinations": {
          "images-destination": {
            "Address": "http://VidensVejen-ImageService:8080/v1/images"
          }
        }
      },
      "theme-images-cluster": {
        "Destinations": {
          "theme-images-destination": {
            "Address": "http://VidensVejen-ImageService:8080/images/themes"
          }
        }
      }
    }
  }
}
